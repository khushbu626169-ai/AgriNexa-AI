# ==========================================
# AgriNexa AI — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Storage / Database
# Primary local storage: high-performance SQLite in WAL mode
SQLITE_DB_PATH=./data/agrinexa.db
# Optional: MongoDB connection URI (e.g. mongodb://localhost:27017/agrinexa)
MONGODB_URI=

# Large Language Model (LLM) Configuration
# Supported providers: 'gemini', 'openai', or 'local_heuristic'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Authoritative Government Mandi APIs
# Official Open Government Data (data.gov.in) API Key for Agmarknet API
# Obtain freely at https://data.gov.in (Directorate of Marketing & Inspection)
DATAGOV_API_KEY=your_data_gov_in_api_key_here

# Automated Scheduler Configuration
# Polling interval for official portals (cron format, default: every 4 hours)
INGESTION_CRON_SCHEDULE=0 */4 * * *
# Run ingestion immediately upon backend startup
INGESTION_RUN_ON_STARTUP=true

# Cache TTL (milliseconds) for Mandi price lookups (default: 1 hour)
MANDI_CACHE_TTL_MS=3600000

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
